# Copy to .env.local and fill in. With these unset the app runs in DEMO mode
# with synthetic tide data so you can preview the UI without a backend.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Only for scripts/push-forecast.mjs (the Danish-IP forecast pusher). Same value as the
# Supabase secret FORECAST_PUSH_TOKEN. Not a VITE_ var, so it never reaches the browser.
# FORECAST_PUSH_TOKEN=
